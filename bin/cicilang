#!/bin/sh
# cicilang -- the cicilang compiler. Arguments as clang's, so nothing is new:
#
#   cicilang prog.c -o prog            read, check, lower, compile, link -> prog (a.out without -o)
#   cicilang -c prog.c                 -> prog.o          cicilang -S prog.c        -> prog.s
#   cicilang -emit-llvm -c prog.c      -> prog.ll         cicilang -fsyntax-only prog.c
#   cicilang -E prog.c                 -> the preprocessed text (cocolog's preprocessor), -o FILE to a file
#   cicilang -O2 a.c b.c util.o -lm -o app               cicilang -shared -O1 lib.c -o lib.dylib
#   cicilang -I include -I ../h prog.c                   cicilang -ast-dump prog.c
#   cicilang --version                                   cicilang -v ... (say each step)
#
# The knowledge base is ~/.cicilang/KB, the user's (or $CICILANG_KB): the first
# call is the initialization phase, reading the C standard library, the OS's
# and POSIX's headers once; every later call, in any project, the tests
# included, is served from it as static data, until the SDK or the reader's
# grammar changes. --no-kb keeps everything in memory.
# Diagnostics are file:line: error: what, the exit status 1 when any.
# every $(...) and every pipe is a fork, 10 ms each on macOS: the script
# forks six times where it forked twenty, and the floor of a build fell by
# a quarter of a second (bench/compile/run.sh)
case $0 in */*) HERE=$(cd "${0%/*}" && pwd) ;; *) HERE=$(cd "$(dirname "$(command -v "$0")")" && pwd) ;; esac
ROOT=${HERE%/*}
COCOLOG=${COCOLOG:-$HOME/Projects/GitHub/cocolog}
if [ -x "$COCOLOG/cocolog" ]; then C="$COCOLOG/cocolog"; elif command -v cocolog >/dev/null 2>&1; then C=$(command -v cocolog); else echo "cicilang: no cocolog (set COCOLOG)" >&2; exit 1; fi
export COCOLOG_LIBRARY="$ROOT/library${COCOLOG_LIBRARY:+:$COCOLOG_LIBRARY}"
KB=${CICILANG_KB:-$HOME/.cicilang/KB}
me=${CICILANG_ME:-cicilang}                # cicilang++ runs this script with CICILANG_LANG=cpp, its own name, its own store
store="--embed $KB"
# The store is stamped with the reader's grammar version (KB.version beside
# it): a new version makes every row dead, and cocolog's store never reclaims
# a retracted row -- a store grown fat slows every predicate's first call --
# so a new version starts a new store. test/config.sh is this function's twin.
kb_prepare() {                        # one awk for both versions, read for the stamp
  v=$(awk '/^ccl_reader_version\(/ { sub(/^ccl_reader_version\(/, ""); sub(/\).*/, ""); r = $0 } /^ccl_lowering_version\(/ { sub(/^ccl_lowering_version\(/, ""); sub(/\).*/, ""); l = $0 } END { print r "." l }' "$ROOT/library/ccl_syntax.pl" "$ROOT/library/ccl_ir.pl")
  stamp="$1.version"; have=""
  [ -f "$stamp" ] && read -r have < "$stamp"
  if [ -f "$1/data.bin" ] && [ "$have" != "$v" ]; then rm -rf "$1"; have=""; fi
  [ -d "$1" ] || mkdir -p "$1"
  [ "$have" = "$v" ] || echo "$v" > "$stamp"
  # THE STORE IS VACUUMED every 64th run (0.128): a process that writes a predicate rewrites all of it, and the dead rows of
  # every edited file's read and IR stay until cocolog's vacuum takes them (0.4 s over a 25 MB store); KB.runs counts, read
  # and written without a fork
  runs=0; [ -f "$1.runs" ] && read -r runs < "$1.runs"
  case "$runs" in ''|*[!0-9]*) runs=0 ;; esac
  runs=$((runs + 1))
  if [ "$runs" -ge 64 ]; then [ -f "$1/data.bin" ] && "$C" --embed "$1" vacuum > /dev/null 2>&1 < /dev/null; runs=0; fi
  echo "$runs" > "$1.runs"
}
inputs=""; opts=""; out=""; opt=""; verbose=""; defs=""; gdbg=""
[ "${CICILANG_LANG:-c}" = cpp ] && opts="$opts lang(cpp),"
need() { [ $# -ge 2 ] || { echo "$me: error: argument to '$1' is missing" >&2; exit 1; }; }
q() { case $1 in *\'*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/\\\\'/g")" ;; *) printf "'%s'" "$1" ;; esac; }
while [ $# -gt 0 ]; do
  case "$1" in
    --version) "$C" --local query "use_module(library(cicilang)), ccl_version(V), ( catch(ccl_cocolog_version(CV), _, fail) -> true ; CV = '?' ), ( catch(use_module(library(ccl_llvm)), _, fail), catch(ccl_llvm_version(L), _, fail) -> true ; L = 'not built' ), write('cicilang '), write(V), write(' (cocolog '), write(CV), write('; LLVM '), write(L), write(')'), nl" 2>/dev/null | grep -a "^cicilang"; exit 0 ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -c) opts="$opts compile_only," ;;
    -S) opts="$opts assembly," ;;
    -emit-llvm) opts="$opts emit_llvm," ;;
    -fsyntax-only) opts="$opts syntax_only," ;;
    -E) opts="$opts preprocess," ;;
    -ast-dump) opts="$opts ast," ;;
    -v) opts="$opts verbose,"; verbose=1 ;;
    --no-kb) store="--local" ;;
    -o) need "$@"; shift; out="$1" ;;
    -o*) out="${1#-o}" ;;
    -O0|-O1|-O2|-O3|-Os|-Oz) opt="$1" ;;
    -I) need "$@"; shift; opts="$opts include($(q "$1"))," ;;
    -I*) opts="$opts include($(q "${1#-I}"))," ;;
    -l*|-L*|-shared|-Wl,*|-framework|-static|-rdynamic|-fPIC|-pthread|-m*) case "$1" in -framework) need "$@"; opts="$opts link('-framework'),"; shift ;; esac; opts="$opts link($(q "$1"))," ;;
    -std=c++17|-std=gnu++17|-std=c++1z|-std=gnu++1z) opts="$opts std(17)," ;;   # the language level: C++17 the baseline, then the majors
    -std=c++20|-std=gnu++20|-std=c++2a|-std=gnu++2a) opts="$opts std(20)," ;;
    -std=c++23|-std=gnu++23|-std=c++2b|-std=gnu++2b) opts="$opts std(23)," ;;
    -std=c++26|-std=gnu++26|-std=c++2c|-std=gnu++2c) opts="$opts std(26)," ;;
    -std=c++*|-std=gnu++*) echo "$me: error: unsupported C++ standard '$1' (C++17 and later)" >&2; exit 1 ;;
    -std=c23|-std=gnu23|-std=c2x|-std=gnu2x) opts="$opts cstd(23)," ;;          # C's level: C17 the baseline, C23 the forms below
    -std=c17|-std=c18|-std=iso9899:2017|-std=iso9899:2018) opts="$opts cstd(17), trigraphs," ;;   # the ISO modes read trigraphs, the GNU ones do not (clang's rule)
    -std=gnu17|-std=gnu18) opts="$opts cstd(17)," ;;
    -std=c11|-std=iso9899:2011) opts="$opts cstd(11), trigraphs," ;;
    -std=gnu11) opts="$opts cstd(11)," ;;
    -std=c99|-std=iso9899:1999) opts="$opts cstd(99), trigraphs," ;;
    -std=gnu99) opts="$opts cstd(99)," ;;
    -trigraphs) opts="$opts trigraphs," ;;
    -std=c89|-std=c90|-std=gnu89|-std=gnu90|-std=iso9899:1990) echo "$me: error: unsupported C standard '$1' (C99 and later)" >&2; exit 1 ;;
    -D) need "$@"; shift; opts="$opts define($(q "$1")),"; defs=1 ;;   # a macro on the command line (0.112): it changes what every header reads, so the run keeps no store
    -D*) opts="$opts define($(q "${1#-D}")),"; defs=1 ;;
    -U) need "$@"; shift; opts="$opts undef($(q "$1")),"; defs=1 ;;
    -U*) opts="$opts undef($(q "${1#-U}")),"; defs=1 ;;
    -g0|-ggdb0) gdbg="" ;;   # no debug information, as clang; the last -g form wins
    -g1|-ggdb1|-gline-tables-only|-gline-directives-only) gdbg="debug(lines)," ;;   # the line tables alone (0.130)
    -g|-g[23]|-ggdb|-ggdb[23]|-gdwarf*|-gfull|-glldb|-gsce) gdbg="debug," ;;   # -g: the line tables (0.128), the variables, their types and the blocks (0.130)
    -W*|-f*|-std=*|-pedantic|-g*) ;;   # accepted for clang's sake
    -*) echo "$me: error: unknown argument: '$1'" >&2; exit 1 ;;
    *) inputs="$inputs $(q "$1"),";;
  esac
  shift
done
[ -n "$inputs" ] || { echo "$me: error: no input files" >&2; exit 1; }
[ -n "$gdbg" ] && opts="$opts $gdbg"
[ -n "$out" ] && opts="$opts out($(q "$out")),"
[ -n "$opt" ] && opts="$opts opt('$opt'),"
inputs="[${inputs%,}]"; opts="[${opts%,}]"
[ -n "$defs" ] && store="--local"   # the store keys a header by its path: under -D it would serve another header's read
case "$store" in --embed*) kb_prepare "$KB" ;; esac
res=$("$C" $store query "use_module(library(cicilang)), ccl_drive($inputs, $opts)" 2>&1)
# one pass over the answer: diagnostics on stderr, as clang; `cicilang: ...' and `unit(...)' lines on stdout
case "$opts" in
  *preprocess*) printf '%s\n' "$res" | awk '/: error: |: warning: |: note: / { print > "/dev/stderr"; next } /^cicilang: |^ +[0-9]+\. use_module|answer\(s\)\.$/ { next } { print }' ;;   # -E: the text itself
  *) printf '%s\n' "$res" | awk '/: error: |: warning: |: note: / { print > "/dev/stderr"; next } /^cicilang: ok$/ { next } /^cicilang: |^unit\(/ { print }' ;;
esac
case "$res" in
  *"cicilang: ok"*) exit 0 ;;
  *"cicilang: "[0-9]*" error"*) exit 1 ;;
esac
printf '%s\n' "$res" | grep -a "ERROR\|error" | head -3 | sed 's/^/cicilang: /'
exit 1
