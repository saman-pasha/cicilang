# test/toolchain.pins -- the toolchain the gates were last GREEN on (0.226). test/toolchain.sh checks the box against it,
# and test/ci.sh -- the CI job's steps, .github/workflows/gates.yml -- clones the neighbours at these commits. A pin moves
# only on the owner's word, in the step that runs the chain over it (CLAUDE.md: the neighbours, and the versions).
CICILI_COMMIT=9b825b7
CICILI_VERSION=3.3.0
COCOLOG_COMMIT=1e48013
COCOLOG_VERSION=2.14.1
ZIGURATIP_COMMIT=90d99b8
# the embedded LLVM (module/build-llvm.sh, over llvm-c) and the C gates' clang
LLVM_MAJOR=18
# the libc++ trees the C++ gates read, one pass each: LLVM=/usr/lib/llvm-N sh test/libcxx.sh, then test/cpp.sh
LIBCXX_TREES="18 21"
